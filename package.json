{
  "name": "cloudflare-workers-openapi",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.4",
    "@cloudflare/workers-types": "5.20261018.1",
    "@types/lodash": "4.17.26",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  },
  "dependencies": {
    "chanfana": "3.4.0",
    "hono": "4.13.13",
    "lodash": "4.18.1",
    "zod": "4.6.7"
  },
  "scripts": {
    "dev": "pnpm typecheck && wrangler dev",
    "typecheck": "tsc --noEmit && wrangler types",
    "test": "npx vitest run",
    "test:watch": "npx vitest",
    "test:coverage": "npx vitest --coverage",
    "db:migrate:local": "wrangler d1 migrations apply veeu-db-staging --local",
    "db:migrate:staging": "wrangler d1 migrations apply veeu-db-staging --remote",
    "db:migrate:production": "wrangler d1 migrations apply veeu-db-production --remote",
    "deploy:staging": "pnpm run test && pnpm run typecheck && wrangler deploy --env staging",
    "deploy:production": "pnpm run test && pnpm run typecheck && wrangler deploy --env production"
  }
}